# ==============================================================================
# CONFIGURACIÓN DE PRODUCCIÓN - RENDER.COM & SUPABASE (POSTGRESQL)
# Copia estos valores en el panel "Environment" de tu Web Service en Render.com
# ==============================================================================

APP_NAME="Ferretería Las F"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://tu-servicio.onrender.com # Reemplazar con la URL asignada por Render

# Genera una clave con: php artisan key:generate --show
APP_KEY=base64:COPIA_AQUI_TU_APP_KEY

# ------------------------------------------------------------------------------
# CONEXIÓN A SUPABASE (PostgreSQL)
# Obtén estos datos en tu proyecto de Supabase:
# Project Settings -> Database -> Connection Parameters
# ------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=aws-0-sa-east-1.pooler.supabase.com # Tu host de Supabase
DB_PORT=6543 # 6543 (Pooler / Recomendado) o 5432 (Directo)
DB_DATABASE=postgres
DB_USERNAME=postgres.tu_id_de_proyecto # Tu usuario de Supabase
DB_PASSWORD=tu_contraseña_de_supabase
DB_SSLMODE=require

# ------------------------------------------------------------------------------
# SESIONES, CACHÉ Y COLAS
# Usamos 'database' para que persistan en PostgreSQL sin costo adicional
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

# ------------------------------------------------------------------------------
# PRIMER DESPLIEGUE (SEEDERS AUTOMÁTICOS)
# Coloca 'true' en el primer despliegue para crear:
# - Admin: admin@ferreteria.com / password123
# - Cajero: cajero@ferreteria.com / password123
# - Cajas 1, 2 y 3, Bodega Principal, Listas de precios y productos iniciales.
# Una vez desplegado con éxito, puedes cambiarlo a 'false'.
# ------------------------------------------------------------------------------
RUN_SEEDER=true

# Logs en stdout para verlos directamente en la consola de Render
LOG_CHANNEL=stderr
LOG_LEVEL=info
